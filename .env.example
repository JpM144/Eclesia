SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Cadena de conexión del proyecto de Supabase usada por el comando
# ``respaldar_supabase``. Se saca del panel de Supabase en Connect →
# Session pooler (puerto 5432). Nunca se sube a Git: este archivo solo
# documenta la variable, el valor real va en .env.
SUPABASE_DB_URL=

# Código que se pide al crear una cuenta desde /cuentas/registro/.
# Déjalo vacío para deshabilitar el autorregistro (solo el admin crea usuarios).
CODIGO_REGISTRO=

# Nombre de la parroquia que se muestra bajo "Gestión Parroquial" en el menú
# lateral. Déjalo vacío para no mostrar esa línea.
NOMBRE_PARROQUIA=

# Nombre de la diócesis que consta en las hojas de partida y en los
# certificados. Déjalo vacío para no mostrar esa línea.
NOMBRE_DIOCESIS=

# Edades de referencia para las reglas de los sacramentos
# (docs/requisitos_sacramentos.md). Ajustables según la Conferencia
# Episcopal o la diócesis.
EDAD_MINIMA_PADRINO=16
EDAD_USO_RAZON=7
EDAD_MINIMA_CONFIRMACION=7
EDAD_MINIMA_MATRIMONIO_VARON=16
EDAD_MINIMA_MATRIMONIO_MUJER=14
EDAD_LICITA_MATRIMONIO=18
